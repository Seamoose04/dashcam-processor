# Copy this file to .env and fill in before running `docker compose up`.
# RUNNER_TOKEN  = one-time registration token from:
#   repo -> Settings -> Actions -> Runners -> New self-hosted runner (Linux + Docker)
# RUNNER_URL    = your org/repo URL the runner registers against, e.g.
#   https://github.com/Seamoose04/dashcam-processor

RUNNER_TOKEN=
RUNNER_URL=https://github.com/Seamoose04/dashcam-processor
